# Database connection string (Supabase Postgres pooler string)
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# JWT signing secret (Required, min 32 chars recommended)
JWT_SECRET=super_secret_edtech_jwt_signing_key_replace_in_production
JWT_EXPIRES_IN=8h

# Server port and environment
PORT=5050
NODE_ENV=development

# Frontend origin allowed by CORS (no trailing slash)
FRONTEND_URL=http://localhost:5173


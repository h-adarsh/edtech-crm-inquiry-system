# ==============================================================================
# EdTech CRM — Root Environment Variables Sample
# Copy these to backend/.env and frontend/.env respectively
# ==============================================================================

# --- Backend Configuration (backend/.env) ---
# Supabase Pooler Connection String (Session/Transaction pooler on port 5432 or 6543)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# JWT Secret for custom authentication signing (Generate a random string)
JWT_SECRET=super_secret_edtech_jwt_signing_key_replace_in_production
JWT_EXPIRES_IN=8h

# Server port and environment
PORT=5050
NODE_ENV=development

# Allowed Frontend URL for CORS (without trailing slash)
FRONTEND_URL=http://localhost:5173

# --- Frontend Configuration (frontend/.env) ---
# Base API URL pointing to the Express backend
VITE_API_URL=http://localhost:5050/api